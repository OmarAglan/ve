<?xml version="1.0" encoding="UTF-8"?>
<project name="ve" default="help">
    <property file="local.properties"/>
    <property file="ant.properties"/>
    <property file="project.properties"/>
    <property environment="env"/>

    <condition property="sdk.dir" value="${env.ANDROID_HOME}">
        <and>
            <not><isset property="sdk.dir"/></not>
            <isset property="env.ANDROID_HOME"/>
        </and>
    </condition>
    <condition property="sdk.dir" value="${env.ANDROID_SDK_ROOT}">
        <and>
            <not><isset property="sdk.dir"/></not>
            <isset property="env.ANDROID_SDK_ROOT"/>
        </and>
    </condition>

    <property name="project.name" value="ve"/>
    <property name="sdk.api.level" value="34"/>
    <property name="build.tools.version" value="34.0.0"/>

    <property name="src.dir" value="src"/>
    <property name="gen.dir" value="gen"/>
    <property name="res.dir" value="res"/>
    <property name="libs.dir" value="libs"/>
    <property name="obj.dir" value="obj"/>
    <property name="obj.classes.dir" value="${obj.dir}/classes"/>
    <property name="obj.dex.dir" value="${obj.dir}/dex"/>
    <property name="bin.dir" value="bin"/>

    <property name="platform.dir" value="${sdk.dir}/platforms/android-${sdk.api.level}"/>
    <property name="android.jar" value="${platform.dir}/android.jar"/>
    <property name="framework.aidl" value="${platform.dir}/framework.aidl"/>
    <property name="build.tools.dir" value="${sdk.dir}/build-tools/${build.tools.version}"/>
    <property name="aapt" value="${build.tools.dir}/aapt"/>
    <property name="aidl" value="${build.tools.dir}/aidl"/>
    <property name="d8" value="${build.tools.dir}/d8"/>
    <property name="zipalign" value="${build.tools.dir}/zipalign"/>
    <property name="apksigner" value="${build.tools.dir}/apksigner"/>

    <property name="unsigned.unaligned.apk" value="${bin.dir}/${project.name}-unaligned-unsigned.apk"/>
    <property name="unsigned.aligned.apk" value="${bin.dir}/${project.name}-aligned-unsigned.apk"/>
    <property name="debug.apk" value="${bin.dir}/${project.name}-debug.apk"/>

    <property name="debug.keystore.path" value="${user.home}/.android/debug.keystore"/>
    <property name="debug.keystore.alias" value="androiddebugkey"/>
    <property name="debug.keystore.storepass" value="android"/>
    <property name="debug.keystore.keypass" value="android"/>

    <path id="project.classpath">
        <pathelement location="${android.jar}"/>
        <fileset dir="${libs.dir}">
            <include name="*.jar"/>
        </fileset>
    </path>

    <target name="help" description="Print build guidance for this Ant build.">
        <echo>Vé Ant build entrypoint.</echo>
        <echo>Set sdk.dir in local.properties (or ANDROID_HOME/ANDROID_SDK_ROOT).</echo>
        <echo>Optional overrides: -Dsdk.api.level=34 -Dbuild.tools.version=34.0.0</echo>
        <echo>Run: ant check-sdk</echo>
        <echo>Build APK: ant debug</echo>
    </target>

    <target name="check-sdk" description="Validate required Android SDK and build-tool components.">
        <fail unless="sdk.dir">sdk.dir is not configured. Set sdk.dir in local.properties or ANDROID_HOME/ANDROID_SDK_ROOT.</fail>
        <available file="${android.jar}" property="has.android.jar"/>
        <fail unless="has.android.jar">Missing platform android.jar at ${android.jar}. Install platforms;android-${sdk.api.level} or override -Dsdk.api.level.</fail>
        <available file="${framework.aidl}" property="has.framework.aidl"/>
        <fail unless="has.framework.aidl">Missing framework.aidl at ${framework.aidl}.</fail>
        <available file="${aapt}" property="has.aapt"/>
        <fail unless="has.aapt">Missing aapt at ${aapt}. Install build-tools;${build.tools.version} or override -Dbuild.tools.version.</fail>
        <available file="${aidl}" property="has.aidl"/>
        <fail unless="has.aidl">Missing aidl at ${aidl}. Install build-tools;${build.tools.version}.</fail>
        <available file="${d8}" property="has.d8"/>
        <fail unless="has.d8">Missing d8 at ${d8}. Install build-tools;${build.tools.version}.</fail>
        <available file="${zipalign}" property="has.zipalign"/>
        <fail unless="has.zipalign">Missing zipalign at ${zipalign}. Install build-tools;${build.tools.version}.</fail>
        <available file="${apksigner}" property="has.apksigner"/>
        <fail unless="has.apksigner">Missing apksigner at ${apksigner}. Install build-tools;${build.tools.version}.</fail>
        <echo>SDK OK: sdk.dir=${sdk.dir}</echo>
        <echo>SDK OK: platform=android-${sdk.api.level}, build-tools=${build.tools.version}</echo>
    </target>

    <target name="clean" description="Clean build outputs.">
        <delete dir="${gen.dir}"/>
        <delete dir="${obj.dir}"/>
        <delete dir="${bin.dir}"/>
    </target>

    <target name="prepare" depends="check-sdk">
        <mkdir dir="${gen.dir}"/>
        <mkdir dir="${obj.classes.dir}"/>
        <mkdir dir="${obj.dex.dir}"/>
        <mkdir dir="${bin.dir}"/>
    </target>

    <target name="generate-resources" depends="prepare">
        <exec executable="${aapt}" failonerror="true">
            <arg value="package"/>
            <arg value="-f"/>
            <arg value="-m"/>
            <arg value="-J"/>
            <arg value="${gen.dir}"/>
            <arg value="-M"/>
            <arg value="AndroidManifest.xml"/>
            <arg value="-S"/>
            <arg value="${res.dir}"/>
            <arg value="-I"/>
            <arg value="${android.jar}"/>
        </exec>
    </target>

    <target name="generate-aidl" depends="prepare">
        <exec executable="${aidl}" failonerror="true">
            <arg value="-p"/>
            <arg value="${framework.aidl}"/>
            <arg value="-I"/>
            <arg value="${src.dir}"/>
            <arg value="-o"/>
            <arg value="${gen.dir}"/>
            <arg value="${src.dir}/com/android/vending/billing/IInAppBillingService.aidl"/>
        </exec>
    </target>

    <target name="compile" depends="generate-resources,generate-aidl">
        <javac
            srcdir="${src.dir}:${gen.dir}"
            destdir="${obj.classes.dir}"
            includeantruntime="false"
            source="1.8"
            target="1.8"
            encoding="UTF-8">
            <classpath refid="project.classpath"/>
        </javac>
    </target>

    <target name="jar-classes" depends="compile">
        <jar destfile="${obj.dir}/classes.jar" basedir="${obj.classes.dir}"/>
    </target>

    <path id="dex.program.libs">
        <fileset dir="${libs.dir}">
            <include name="*.jar"/>
        </fileset>
    </path>
    <pathconvert property="dex.program.libs.args" refid="dex.program.libs" pathsep=" "/>

    <target name="dex" depends="jar-classes">
        <exec executable="${d8}" failonerror="true">
            <arg value="--lib"/>
            <arg value="${android.jar}"/>
            <arg value="--output"/>
            <arg value="${obj.dex.dir}"/>
            <arg value="${obj.dir}/classes.jar"/>
            <arg line="${dex.program.libs.args}"/>
        </exec>
    </target>

    <target name="package-resources" depends="prepare">
        <exec executable="${aapt}" failonerror="true">
            <arg value="package"/>
            <arg value="-f"/>
            <arg value="-M"/>
            <arg value="AndroidManifest.xml"/>
            <arg value="-S"/>
            <arg value="${res.dir}"/>
            <arg value="-I"/>
            <arg value="${android.jar}"/>
            <arg value="-F"/>
            <arg value="${unsigned.unaligned.apk}"/>
        </exec>
    </target>

    <target name="package-apk" depends="package-resources,dex">
        <exec executable="${aapt}" failonerror="true">
            <arg value="add"/>
            <arg value="${unsigned.unaligned.apk}"/>
            <arg value="${obj.dex.dir}/classes.dex"/>
        </exec>
        <exec executable="${zipalign}" failonerror="true">
            <arg value="-f"/>
            <arg value="4"/>
            <arg value="${unsigned.unaligned.apk}"/>
            <arg value="${unsigned.aligned.apk}"/>
        </exec>
    </target>

    <target name="debug-keystore-check" depends="prepare">
        <mkdir dir="${user.home}/.android"/>
        <available file="${debug.keystore.path}" property="has.debug.keystore"/>
    </target>

    <target name="debug-keystore-create" depends="debug-keystore-check" unless="has.debug.keystore">
        <exec executable="keytool" failonerror="true">
            <arg value="-genkeypair"/>
            <arg value="-keystore"/>
            <arg value="${debug.keystore.path}"/>
            <arg value="-storepass"/>
            <arg value="${debug.keystore.storepass}"/>
            <arg value="-alias"/>
            <arg value="${debug.keystore.alias}"/>
            <arg value="-keypass"/>
            <arg value="${debug.keystore.keypass}"/>
            <arg value="-dname"/>
            <arg value="CN=Android Debug,O=Android,C=US"/>
            <arg value="-keyalg"/>
            <arg value="RSA"/>
            <arg value="-keysize"/>
            <arg value="2048"/>
            <arg value="-validity"/>
            <arg value="10000"/>
        </exec>
    </target>

    <target name="debug-keystore" depends="debug-keystore-check,debug-keystore-create"/>

    <target name="debug" depends="package-apk,debug-keystore" description="Build a fully signed debug APK.">
        <exec executable="${apksigner}" failonerror="true">
            <arg value="sign"/>
            <arg value="--ks"/>
            <arg value="${debug.keystore.path}"/>
            <arg value="--ks-key-alias"/>
            <arg value="${debug.keystore.alias}"/>
            <arg value="--ks-pass"/>
            <arg value="pass:${debug.keystore.storepass}"/>
            <arg value="--key-pass"/>
            <arg value="pass:${debug.keystore.keypass}"/>
            <arg value="--out"/>
            <arg value="${debug.apk}"/>
            <arg value="${unsigned.aligned.apk}"/>
        </exec>
        <exec executable="${apksigner}" failonerror="true">
            <arg value="verify"/>
            <arg value="${debug.apk}"/>
        </exec>
        <echo>Built debug APK: ${debug.apk}</echo>
    </target>
</project>
